        "url"
      ],
      "requiredAnyOf": [],
      "mutuallyExclusive": [],
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "callback_url": {
            "type": "string",
            "format": "uri"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Words to look for in the channel's posts."
