{
  "schemaVersion": 1,
  "platform": "telegram",
  "platformName": "Telegram",
  "baseUrl": "https://api.socq.ai",
  "creditUsd": 0.005,
  "endpoints": [
    {
      "publicId": "telegram/channel-info",
      "name": "Telegram Channel Info API",
      "description": "Look up public Telegram channels by t.me link for title, description, avatar, verification badge and subscriber count.",
      "method": "POST",
      "path": "/v1/telegram/channel-info",
      "payload": "payloads/channel-info.json",
      "launchedAt": "2026-11-17",
      "price": "0.5 credits ($0.0025) per result",
      "billing": {
        "baseCredits": 0,
        "mode": "base_plus_result",
        "resultUnitSize": 1,
        "resultUnitCredits": 0.5,
        "estimateResultCount": 1,
        "emptyResultPolicy": "base_only",
        "estimateInputField": "urls"
      },
      "docsUrl": "https://docs.socq.ai/api-manual/telegram/channel-info",
      "landingUrl": "https://socq.ai/apis/telegram/channel-info",
      "required": [
        "urls"
      ],
      "requiredAnyOf": [],
      "mutuallyExclusive": [],
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "callback_url": {
            "type": "string",
            "format": "uri"
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Links to public Telegram channels, up to 50, such as https://t.me/durov.",
            "maxItems": 50
          }
        },
        "required": [
          "urls"
        ],
        "description": "Provide up to 50 public Telegram channel links in urls. Each channel that exists returns one row with its title, description, avatar, verification and subscriber, photo, video and link counts."
      }
    },
    {
      "publicId": "telegram/channel-posts",
      "name": "Telegram Channel Scraper API",
      "description": "Collect a public Telegram channel's posts newest first, with text, publish time, views, reaction totals, photos and videos.",
      "method": "POST",
      "path": "/v1/telegram/channel-posts",
      "payload": "payloads/channel-posts.json",
      "launchedAt": "2026-11-17",
      "price": "0.3 credits ($0.0015) per result",
      "billing": {
        "baseCredits": 0,
        "mode": "base_plus_result",
        "resultUnitSize": 1,
        "resultUnitCredits": 0.3,
        "estimateResultCount": 20,
        "emptyResultPolicy": "base_only"
      },
      "docsUrl": "https://docs.socq.ai/api-manual/telegram/channel-posts",
      "landingUrl": "https://socq.ai/apis/telegram/channel-posts",
      "required": [
        "url"
      ],
      "requiredAnyOf": [],
      "mutuallyExclusive": [],
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "callback_url": {
            "type": "string",
            "format": "uri"
          },
          "results_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 20
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Link to a public Telegram channel, such as https://t.me/durov."
          }
        },
        "required": [
          "url"
        ],
        "description": "Provide one public Telegram channel link in url. Posts come newest first; results_limit defaults to 20 and accepts integers from 1 to 1000."
      }
    },
